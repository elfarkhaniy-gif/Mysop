# Required: secret used to encrypt stored provider keys (any long random string).
FREELLM_MASTER_KEY=change-me-to-a-long-random-string
# Required for /admin routes.
FREELLM_ADMIN_TOKEN=change-me-admin
# Comma-separated client keys accepted on /v1. Leave empty to allow anyone who can reach the port.
FREELLM_API_KEYS=sk-local-1
PORT=8787
HOST=127.0.0.1
FREELLM_DATA_FILE=./data/store.json
# Max providers tried per request before giving up.
FREELLM_MAX_ATTEMPTS=5
# Upstream request timeout in ms.
FREELLM_TIMEOUT_MS=120000
